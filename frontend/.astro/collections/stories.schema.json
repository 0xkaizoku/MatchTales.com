{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "default": "",
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "excerpt": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "readingTime": {
      "default": 5,
      "type": "number"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "category",
    "excerpt",
    "image",
    "pubDate"
  ]
}