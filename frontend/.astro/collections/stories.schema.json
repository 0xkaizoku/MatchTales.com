{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "default": "",
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "excerpt": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "readingTime": {
      "default": 5,
      "type": "number"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "sport": {
      "default": "soccer",
      "type": "string"
    },
    "competition": {
      "default": "",
      "type": "string"
    },
    "relatedSlug": {
      "default": "",
      "type": "string"
    },
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "url"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "category",
    "excerpt",
    "image",
    "pubDate"
  ]
}