{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "headline": {
      "type": "string"
    },
    "whyCareScore": {
      "type": "number"
    },
    "whyCareReason": {
      "type": "string"
    },
    "teaser": {
      "type": "string"
    },
    "story": {
      "type": "string"
    },
    "stakes": {
      "type": "string"
    },
    "rivalryAngle": {
      "type": "string"
    },
    "funFacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keyPlayers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "team": {
            "type": "string"
          },
          "hook": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "team",
          "hook"
        ]
      }
    },
    "headToHead": {
      "default": "",
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "home": {
      "type": "string"
    },
    "away": {
      "type": "string"
    },
    "homeCode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "awayCode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "homeFlag": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "awayFlag": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "group": {
      "type": "string"
    },
    "matchday": {
      "default": 0,
      "type": "number"
    },
    "date": {
      "type": "string"
    },
    "time": {
      "type": "string"
    },
    "venue": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "homeScore": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "awayScore": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "marquee": {
      "default": false,
      "type": "boolean"
    },
    "liveMinute": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "decidedBy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "homePen": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "awayPen": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "sport": {
      "default": "soccer",
      "type": "string"
    },
    "competition": {
      "default": "world-cup-2026",
      "type": "string"
    },
    "format": {
      "default": "team-match",
      "type": "string",
      "enum": [
        "team-match",
        "singles",
        "race",
        "leaderboard"
      ]
    },
    "season": {
      "default": "",
      "type": "string"
    },
    "roundLabel": {
      "default": "",
      "type": "string"
    },
    "resultSummary": {
      "default": "",
      "type": "string"
    },
    "leaderboard": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pos": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "score": {
            "type": "string"
          },
          "note": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "pos",
          "name",
          "score"
        ]
      }
    },
    "tennisSets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "p1": {
            "type": "string"
          },
          "p2": {
            "type": "string"
          }
        },
        "required": [
          "p1",
          "p2"
        ]
      }
    },
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "url"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "slug",
    "headline",
    "whyCareScore",
    "whyCareReason",
    "teaser",
    "story",
    "stakes",
    "rivalryAngle",
    "funFacts",
    "keyPlayers",
    "home",
    "away",
    "group",
    "date",
    "time",
    "venue",
    "city",
    "status"
  ]
}