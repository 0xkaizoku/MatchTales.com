---
import BaseLayout from '../layouts/BaseLayout.astro';
import { data, getFlagUrl, SITE } from '../lib/site';
const groups = Object.keys(data.groups).sort();
const schema = [
  {
    '@type': 'CollectionPage',
    name: 'World Cup 2026 Groups & Standings',
    description: 'All 12 groups of the 2026 World Cup with final standings and match storylines.',
    url: `${SITE.url}/groups`,
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Groups', item: `${SITE.url}/groups` },
    ],
  },
];
---
<BaseLayout title="Groups & Standings | World Cup 2026" description="All 12 groups of the 2026 World Cup with final standings, qualification race context and match storylines." keywords="World Cup 2026 groups, standings, tables, qualification" schema={schema} imageAlt="World Cup 2026 group standings on MatchTales">
  <main class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <header class="mt-8">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h1 class="font-head text-3xl sm:text-4xl font-semibold tracking-tight">Groups & Standings</h1>
          <p class="mt-2 text-muted font-sans max-w-2xl">Twelve groups, 48 teams, final group-stage tables. Top two plus best thirds advanced to the Round of 32.</p>
        </div>
        <a href="/leaderboard" class="text-sm font-sans font-medium text-sky hover:underline underline-offset-4 whitespace-nowrap">Full leaderboards →</a>
      </div>
    </header>
    <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-5 pb-10">
      {groups.map((g) => (
        <a href={`/group/${g.toLowerCase()}`} class="group rounded-card border border-border/80 bg-surface shadow-card hover:shadow-cardhover transition-shadow overflow-hidden">
          <div class="flex items-center justify-between px-4 py-3 border-b border-border/70"><h2 class="font-head font-semibold group-hover:text-pitch transition-colors">Group {g}</h2><span class="text-[11px] text-muted font-sans">View →</span></div>
          <table class="w-full text-sm font-sans">
            <tbody>
              {data.groups[g].map((r: any, i: number) => (
                <tr class="border-b border-border/60 last:border-0">
                  <td class="py-2 pl-4 flex items-center gap-2"><span class={`inline-block w-1 h-4 rounded-full ${i<2?'bg-pitch':i===2?'bg-warning':'bg-transparent'}`}></span><img src={getFlagUrl(r.code)} alt={`${r.name} flag`} class="w-6 h-4" loading="lazy" width="24" height="16" /><span class="font-medium truncate">{r.name}</span></td>
                  <td class="text-center px-2 tabular-nums text-muted">{r.P}</td>
                  <td class="text-center px-2 pr-4 font-semibold tabular-nums">{r.Pts}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
