---
import BaseLayout from '../layouts/BaseLayout.astro';
import MatchStoryCard from '../components/MatchStoryCard.astro';
import { getCollection } from 'astro:content';
import { SITE, isWorldCup, optimizeImage } from '../lib/site';
import { dict, localeFromPath, localePath } from '../i18n';
import FaqSection from '../components/FaqSection.astro';
import type { Locale } from '../i18n';

const locale = (Astro.locals?.locale || localeFromPath(Astro.url.pathname)) as Locale;
const d = dict(locale);
const lp = (p: string) => localePath(locale, p);

const matchEntries = await getCollection('matches');
const matches = matchEntries.map((e) => e.data).filter((m) => isWorldCup(m));
const finalMatch = matches.find((m) => (m.group || '').toUpperCase() === 'FINAL');
const thirdPlace = matches.find((m) => (m.group || '').toUpperCase() === '3RD');
const sf = matches.filter((m) => (m.group || '').toUpperCase() === 'SF').sort((a, b) => a.date.localeCompare(b.date));

const stories = (await getCollection('stories'))
  .map((e) => ({ slug: e.id, ...e.data, image: optimizeImage(e.data.image, 480, 70) }))
  .filter((s) => (s.competition || '') === 'world-cup-2026' || s.category === 'Final Week' || s.category === 'Match Report')
  .sort((a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime())
  .slice(0, 6);

const schema = {
  '@type': 'CollectionPage',
  name: d.worldCup.title,
  description: d.worldCup.description,
  url: `${SITE.url}${lp('/world-cup')}`,
};
---
<BaseLayout
  title={d.worldCup.title}
  description={d.worldCup.description}
  keywords={d.worldCup.keywords}
  schema={schema}
>
  <main class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <header class="mt-8 max-w-2xl">
      <p class="text-[11px] font-sans font-medium text-pitch uppercase tracking-wide">{d.worldCup.kicker}</p>
      <h1 class="mt-2 font-head text-3xl sm:text-4xl font-semibold tracking-tight">{d.worldCup.h1}</h1>
      <p class="mt-3 text-muted font-sans text-lg leading-7">
        {d.worldCup.blurb}
      </p>
    </header>

    <div class="mt-6 flex flex-wrap gap-2 text-sm font-sans">
      <a href={lp('/fixtures')} class="px-3 py-1.5 rounded-full border border-border hover:bg-surface2">{d.worldCup.allFixtures}</a>
      <a href={lp('/groups')} class="px-3 py-1.5 rounded-full border border-border hover:bg-surface2">{d.worldCup.groups}</a>
      <a href={lp('/teams')} class="px-3 py-1.5 rounded-full border border-border hover:bg-surface2">{d.worldCup.teams}</a>
      <a href={lp('/leaderboard')} class="px-3 py-1.5 rounded-full border border-border hover:bg-surface2">{d.worldCup.leaderboards}</a>
      <a href={lp('/stories/spain-world-champions-2026-wrap')} class="px-3 py-1.5 rounded-full bg-pitch text-white">{d.worldCup.wrap}</a>
    </div>

    <section class="mt-12">
      <h2 class="font-head text-xl font-semibold tracking-tight mb-4">{d.worldCup.podium}</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {thirdPlace && <MatchStoryCard m={thirdPlace} />}
        {finalMatch && <MatchStoryCard m={finalMatch} eager />}
      </div>
    </section>

    {sf.length > 0 && (
      <section class="mt-12">
        <h2 class="font-head text-xl font-semibold tracking-tight mb-4">{d.worldCup.semis}</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {sf.map((m) => <MatchStoryCard m={m} />)}
        </div>
      </section>
    )}

    {stories.length > 0 && (
      <section class="mt-12 mb-10">
        <h2 class="font-head text-xl font-semibold tracking-tight mb-4">{d.worldCup.fromArchive}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {stories.map((s) => (
            <a href={lp(`/stories/${s.slug}`)} class="group rounded-card overflow-hidden border border-border/80 bg-surface shadow-card hover:shadow-cardhover transition-shadow">
              <div class="p-4">
                <span class="text-[11px] font-sans font-medium text-pitch uppercase tracking-wide">{s.category}</span>
                <h3 class="mt-1 font-head font-semibold leading-snug group-hover:underline decoration-pitch decoration-2 underline-offset-4">{s.title}</h3>
                <p class="mt-1.5 text-sm text-muted font-sans line-clamp-2">{s.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
    <FaqSection items={[...d.faqs.worldCup]} />
  </main>
</BaseLayout>
