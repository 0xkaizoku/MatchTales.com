---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import FaqSection from '../components/FaqSection.astro';
import { SITE } from '../lib/site';
import { dict, localeFromPath, localePath } from '../i18n';
import type { Locale } from '../i18n';

const locale = (Astro.locals?.locale || localeFromPath(Astro.url.pathname)) as Locale;
const d = dict(locale);
const lp = (p: string) => localePath(locale, p);
const schema = {
  '@type': 'AboutPage',
  name: d.about.title,
  description: d.about.description,
  url: `${SITE.url}${lp('/about')}`,
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: { '@id': `${SITE.url}/#organization` },
};
---
<BaseLayout title={d.about.title} description={d.about.description} keywords={d.about.keywords} schema={schema} imageAlt={d.about.title}>
  <main class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">
      <header class="mt-10">
        <span class="text-[11px] font-sans font-medium text-pitch uppercase tracking-wide">{d.about.kicker}</span>
        <h1 class="mt-2 font-head text-3xl sm:text-4xl font-semibold tracking-tight leading-tight">{d.about.h1}</h1>
      </header>
      <div class="mt-8 space-y-5 text-[18px] leading-8">
        <p>{d.about.p1}</p>
        <p>{d.about.p2} <a href={lp('/sports')} class="text-sky hover:underline">{d.footer.directory}</a>.</p>
        <p>{d.about.p3}</p>
        <p>{d.about.p4}</p>
      </div>
      <div class="mt-10 rounded-card border border-border/80 bg-surface2/60 p-6">
        <h2 class="font-head text-lg font-semibold">{d.about.noteTitle}</h2>
        <p class="mt-2 text-[15px] font-sans text-muted leading-7">{d.about.noteBody}</p>
      </div>
      <FaqSection items={[...d.faqs.about]} />
      <div class="mt-10 mb-10">
        <h2 class="font-head text-xl font-semibold tracking-tight">{d.about.join}</h2>
        <p class="mt-1 text-muted font-sans mb-4">{d.about.joinBlurb}</p>
        <NewsletterForm />
      </div>
    </div>
  </main>
</BaseLayout>
