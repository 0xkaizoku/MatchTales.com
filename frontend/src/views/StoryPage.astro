---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { SITE, contentImage, imgOnError, seoDescription } from '../lib/site';
import SourcesList from '../components/SourcesList.astro';
import SportChip from '../components/SportChip.astro';
import { dict, localeFromPath, localePath, fill } from '../i18n';
import { localizeStory } from '../i18n/content';
import type { Locale } from '../i18n';

const locale = (Astro.locals?.locale || localeFromPath(Astro.url.pathname)) as Locale;
const d = dict(locale);
const lp = (p: string) => localePath(locale, p);
const { entry } = Astro.props;
const matches = await getCollection('matches');
const relatedMatch = entry.data.relatedSlug ? matches.find((m) => m.data.slug === entry.data.relatedSlug)?.data : undefined;
const loc = localizeStory(entry.data, locale, relatedMatch, entry.id);
const { Content } = locale === 'en' ? await render(entry) : { Content: null };
const s = entry.data;
const pub = s.pubDate.toISOString();
const hero = contentImage(s.image, entry.id, 1200, 78);
const og = contentImage(s.image, entry.id, 1200, 80);
const schema = [
  {
    '@type': 'Article',
    headline: loc.title,
    description: seoDescription(loc.excerpt),
    image: [hero],
    datePublished: pub,
    dateModified: pub,
    author: { '@type': 'Organization', name: SITE.name },
    publisher: { '@id': `${SITE.url}/#organization` },
    mainEntityOfPage: `${SITE.url}${lp(`/stories/${entry.id}`)}`,
    articleSection: loc.category,
    inLanguage: locale === 'zh' ? 'zh-Hans' : locale,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: d.common.home, item: `${SITE.url}${lp('/')}` },
      { '@type': 'ListItem', position: 2, name: d.nav.stories, item: `${SITE.url}${lp('/stories')}` },
      { '@type': 'ListItem', position: 3, name: loc.title, item: `${SITE.url}${lp(`/stories/${entry.id}`)}` },
    ],
  },
];
---
<BaseLayout title={loc.title} description={seoDescription(loc.excerpt)} image={og} imageAlt={loc.title} type="article" schema={schema} publishedTime={pub} modifiedTime={pub} preloadImage={hero} keywords={`${loc.category}, ${s.sport || 'soccer'}, ${loc.title}`}>
  <main class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <article class="max-w-2xl mx-auto" data-testid="story-article">
      <nav class="mt-6 text-[13px] font-sans text-muted flex items-center gap-1.5" aria-label={d.common.breadcrumb}><a href={lp('/stories')} class="hover:text-fg">{d.nav.stories}</a><span>/</span><span class="text-fg">{loc.category}</span></nav>
      <div class="mt-6 flex items-center gap-2 flex-wrap">
        <SportChip sport={s.sport || 'soccer'} />
        <span class="text-[11px] font-sans font-medium text-pitch uppercase tracking-wide">{loc.category} · {fill(d.common.minRead, { n: s.readingTime })}</span>
      </div>
      <h1 class="mt-2 font-head text-3xl sm:text-4xl font-semibold tracking-tight leading-[1.1]">{loc.title}</h1>
      {loc.subtitle && <p class="mt-3 text-xl text-muted font-sans">{loc.subtitle}</p>}
      <img src={hero} alt={loc.title} width="672" height="378" class="mt-6 w-full aspect-[16/9] object-cover rounded-card border border-border/70 bg-surface2" fetchpriority="high" decoding="async" sizes="(max-width: 672px) 100vw, 672px" onerror={imgOnError(entry.id)} />
      {locale === 'en' ? (
        <div class="prose-mt mt-8 text-[18px] leading-8 dropcap"><Content /></div>
      ) : (
        <div class="prose-mt mt-8 text-[18px] leading-8 dropcap">
          {loc.body.map((p) => <p>{p}</p>)}
        </div>
      )}
      <SourcesList sources={s.sources} />
      {s.relatedSlug && <p class="mt-6 text-sm font-sans"><a href={lp(`/match/${s.relatedSlug}`)} class="text-sky hover:underline underline-offset-2">{d.common.openEvent}</a></p>}
      <div class="mt-10 pt-6 border-t border-border/70 flex items-center justify-between">
        <a href={lp('/stories')} class="text-sm font-sans font-medium text-sky hover:underline underline-offset-4">{d.common.moreStories}</a>
        <a href={lp('/sports')} class="text-sm font-sans font-medium text-muted hover:text-fg hover:underline underline-offset-4">{d.footer.directory}</a>
      </div>
    </article>
  </main>
</BaseLayout>
<style is:global>
  .prose-mt h2 { font-family: 'Space Grotesk', sans-serif; font-size: 1.5rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.75rem; letter-spacing: -0.01em; }
  .prose-mt h3 { font-family: 'Space Grotesk', sans-serif; font-size: 1.2rem; font-weight: 600; margin-top: 1.5rem; margin-bottom: 0.5rem; }
  .prose-mt p { margin-bottom: 1.1rem; }
  .prose-mt ul { list-style: disc; padding-left: 1.4rem; margin-bottom: 1.1rem; }
  .prose-mt li { margin-bottom: 0.4rem; }
  .prose-mt blockquote { border-left: 3px solid hsl(var(--pitch)); padding-left: 1rem; font-style: italic; color: hsl(var(--muted)); margin: 1.2rem 0; }
  .prose-mt strong { color: hsl(var(--fg)); font-weight: 600; }
  .prose-mt a { color: hsl(var(--accent-sky)); text-decoration: underline; text-underline-offset: 3px; }
</style>
