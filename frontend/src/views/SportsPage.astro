---
import BaseLayout from '../layouts/BaseLayout.astro';
import SportDirectory from '../components/SportDirectory.astro';
import FaqSection from '../components/FaqSection.astro';
import { SITE, SITE_TODAY } from '../lib/site';
import { dict, localeFromPath, localePath } from '../i18n';
import { fmtDateI18n } from '../i18n/content';
import type { Locale } from '../i18n';

const locale = (Astro.locals?.locale || localeFromPath(Astro.url.pathname)) as Locale;
const d = dict(locale);
const schema = {
  '@type': 'CollectionPage',
  name: d.sportsPage.schemaName,
  description: d.sportsPage.description,
  url: `${SITE.url}${localePath(locale, '/sports')}`,
  isPartOf: { '@id': `${SITE.url}/#website` },
};
---
<BaseLayout
  title={d.sportsPage.title}
  description={d.sportsPage.description}
  keywords={d.sportsPage.keywords}
  schema={schema}
  imageAlt={d.sportsPage.schemaName}
>
  <main class="max-w-container mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <header class="mt-8 max-w-2xl">
      <p class="text-[11px] font-sans font-medium uppercase tracking-wide text-muted">{d.sportsPage.kicker} · {fmtDateI18n(locale, SITE_TODAY)}</p>
      <h1 class="mt-2 font-head text-3xl sm:text-5xl font-semibold tracking-tight leading-[1.05] text-balance">{d.sportsPage.h1}</h1>
      <p class="mt-3 text-muted font-sans text-lg leading-7">{d.sportsPage.blurb}</p>
    </header>

    <div class="mt-8">
      <SportDirectory compact />
    </div>
    <FaqSection items={[...d.faqs.sports]} />
  </main>
</BaseLayout>
