---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE, sportOf, fmtDate } from '../lib/site';
import CompetitorMark from '../components/CompetitorMark.astro';
import { dict, localeFromPath, localePath, sportCopy } from '../i18n';
import { scoreDisplayI18n, statusLabelI18n } from '../i18n/content';
import type { Locale } from '../i18n';

const locale = (Astro.locals?.locale || localeFromPath(Astro.url.pathname)) as Locale;
const d = dict(locale);
const lp = (p: string) => localePath(locale, p);
const entries = await getCollection('matches');
const matches = entries.map((e) => e.data);
const upcomingAll = matches
  .filter((m) => m.status === 'UPCOMING')
  .sort((a, b) => a.date.localeCompare(b.date) || b.whyCareScore - a.whyCareScore);
const liveMatch =
  matches.find((m) => m.status === 'LIVE') ||
  matches.find((m) => m.slug === 'lions-at-bills-tnf-2026') ||
  upcomingAll[0] ||
  matches.filter((m) => m.status === 'FINISHED').sort((a, b) => b.date.localeCompare(a.date))[0] ||
  matches[0];
const upcoming = upcomingAll.filter((m) => m.slug !== liveMatch.slug).slice(0, 5);
const sport = sportOf(liveMatch);
const sportMeta = sportCopy(locale, sport);
const score = scoreDisplayI18n(locale, liveMatch);
const isLive = liveMatch.status === 'LIVE';
const notes = [
  { k: d.livePage.why, t: liveMatch.whyCareReason },
  { k: d.livePage.now, t: liveMatch.teaser },
  { k: d.livePage.stake, t: liveMatch.stakes },
].filter((n) => n.t);
const schema = {
  '@type': 'WebPage',
  name: d.livePage.h1,
  description: d.livePage.description,
  url: `${SITE.url}${lp('/live')}`,
  isPartOf: { '@id': `${SITE.url}/#website` },
};
---
<BaseLayout title={d.livePage.title} description={d.livePage.description} keywords={d.livePage.keywords} schema={schema} imageAlt={d.livePage.h1}>
  <main class="max-w-container mx-auto px-4 sm:px-6 lg:px-8 pb-10">
    <header class="mt-8">
      <h1 class="font-head text-3xl sm:text-4xl font-semibold tracking-tight">{d.livePage.h1}</h1>
      <p class="mt-2 text-muted font-sans max-w-2xl">{d.livePage.blurb}</p>
    </header>

    <div class="mt-6 grid lg:grid-cols-3 gap-6" data-testid="live-screen" data-slug={liveMatch.slug}>
      <!-- main live panel -->
      <div class="lg:col-span-2 space-y-5">
        <div class="rounded-card border border-border/80 bg-surface shadow-card overflow-hidden">
          <div class="flex items-center justify-between px-5 py-3 border-b border-border/70 bg-surface2">
            <span class="inline-flex items-center gap-2 text-sm font-sans font-semibold">{isLive ? <span class="inline-flex items-center gap-1.5 text-coral"><span class="w-2 h-2 rounded-full bg-coral pulse-glow"></span>{d.status.LIVE}</span> : <span class="text-muted">{statusLabelI18n(locale, liveMatch.status)}</span>}</span>
            <span class="text-[12px] font-sans text-muted">{sportMeta?.label} · {liveMatch.roundLabel || liveMatch.group} · {liveMatch.venue}</span>
          </div>
          <div class="p-6">
            <div class="flex items-center justify-between gap-4">
              <div class="text-center flex-1"><div class="flex justify-center"><CompetitorMark name={liveMatch.home} code={liveMatch.homeCode} sport={sport} size="lg" /></div><div class="mt-2 font-head font-semibold">{liveMatch.home}</div></div>
              <div class="text-center">
                {score ? (
                  <>
                    <div id="live-score" class="font-head font-bold text-4xl tabular-nums">{score.main}</div>
                    {score.note && <div class="mt-1 text-[12px] font-sans text-muted">{score.note}</div>}
                  </>
                ) : (
                  <div id="live-score" class="font-head font-bold text-3xl tabular-nums">{liveMatch.time}</div>
                )}
                <div id="live-clock" class="mt-1 text-[12px] font-mono text-muted">{isLive && liveMatch.liveMinute ? (typeof liveMatch.liveMinute === 'number' ? liveMatch.liveMinute + "'" : liveMatch.liveMinute) : `${fmtDate(liveMatch.date)} · ${liveMatch.venue}`}</div>
              </div>
              <div class="text-center flex-1"><div class="flex justify-center"><CompetitorMark name={liveMatch.away} code={liveMatch.awayCode} sport={sport} size="lg" /></div><div class="mt-2 font-head font-semibold">{liveMatch.away}</div></div>
            </div>
          </div>
        </div>

        <!-- hype meter -->
        <div class="rounded-card border border-border/80 bg-surface shadow-card p-5">
          <div class="flex items-center justify-between"><h2 class="font-head font-semibold">{d.livePage.hypeMeter}</h2><span id="hype-num" data-testid="live-hype-meter" class="font-head font-bold text-2xl text-pitch tabular-nums">{liveMatch.whyCareScore.toFixed(1)}</span></div>
          <div class="mt-2 h-3 w-full rounded-full bg-border/60 overflow-hidden"><div id="hype-bar" class="h-full rounded-full bg-pitch transition-[width] duration-700" style={`width:${(liveMatch.whyCareScore/10)*100}%`}></div></div>
          <p class="mt-2 text-sm text-muted font-sans">{liveMatch.whyCareReason}</p>
        </div>

        <!-- commentary -->
        <div class="rounded-card border border-border/80 bg-surface shadow-card p-5">
          <h2 class="font-head font-semibold mb-3">{d.livePage.whyOn}</h2>
          <ul id="commentary" data-testid="live-commentary-feed" class="space-y-3 font-sans text-sm">
            {notes.map((n) => (
              <li class="flex gap-3">
                <span class="shrink-0 font-mono text-[11px] text-coral pt-0.5">{n.k}</span>
                <span>{n.t}</span>
              </li>
            ))}
          </ul>
          <p class="mt-3 text-[12px] text-muted font-sans">No invented scoreline. If a ball has not been played, the page does not pretend it has.</p>
        </div>
      </div>

      <!-- side: poll + queue -->
      <aside class="space-y-5">
        <div class="rounded-card border border-border/80 bg-surface shadow-card p-5" data-testid="live-poll">
          <h2 class="font-head font-semibold">Who wins?</h2>
          <p class="text-sm text-muted font-sans mt-0.5 mb-3">{liveMatch.home} vs {liveMatch.away}</p>
          <div class="space-y-2">
            <button class="poll-opt w-full" data-opt="home"><span class="poll-label inline-flex items-center gap-1.5"><CompetitorMark name={liveMatch.home} code={liveMatch.homeCode} sport={sportOf(liveMatch)} size="sm" />{liveMatch.home}</span></button>
            {sportOf(liveMatch) === 'soccer' && <button class="poll-opt w-full" data-opt="draw"><span class="poll-label">Draw</span></button>}
            <button class="poll-opt w-full" data-opt="away"><span class="poll-label inline-flex items-center gap-1.5"><CompetitorMark name={liveMatch.away} code={liveMatch.awayCode} sport={sportOf(liveMatch)} size="sm" />{liveMatch.away}</span></button>
          </div>
          <p id="poll-msg" class="mt-3 text-[12px] text-muted font-sans">Tap to vote · results update live</p>
        </div>
        <div class="rounded-card border border-border/80 bg-surface shadow-card p-5">
          <h2 class="font-head font-semibold mb-3">Coming up</h2>
          <ul class="space-y-3">
            {upcoming.map((m) => (
              <li>
                <a href={lp(`/match/${m.slug}`)} class="flex items-center justify-between gap-2 group">
                  <span class="font-sans text-sm group-hover:text-pitch">
                    <span class="inline-flex items-center gap-1"><CompetitorMark name={m.home} code={m.homeCode} sport={sportOf(m)} size="sm" /></span>
                    <span class="mx-0.5">{m.home}</span> v <span class="mx-0.5">{m.away}</span>
                    <span class="inline-flex items-center gap-1"><CompetitorMark name={m.away} code={m.awayCode} sport={sportOf(m)} size="sm" /></span>
                  </span>
                  <span class="text-[11px] text-muted font-sans">{m.whyCareScore.toFixed(1)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </main>
  <style>
    .poll-opt{display:flex;align-items:center;justify-content:space-between;position:relative;overflow:hidden;border:1px solid hsl(var(--border));border-radius:12px;padding:0.6rem 0.9rem;font-family:'Space Grotesk',sans-serif;font-size:0.9rem;transition:background-color .15s, border-color .15s;background:hsl(var(--bg))}
    .poll-opt:hover{border-color:hsl(var(--pitch))}
    .poll-fill{position:absolute;inset:0;background:hsl(var(--pitch)/0.14);width:0;transition:width .6s cubic-bezier(.2,.8,.2,1)}
    .poll-pct{position:relative;font-variant-numeric:tabular-nums;color:hsl(var(--muted));font-size:0.8rem}
    .poll-label{position:relative}
  </style>
  <script>
    function bindLiveScreen() {
      const root = document.querySelector<HTMLElement>('[data-testid="live-screen"]');
      if (!root || root.dataset.bound) return;
      root.dataset.bound = '1';
      const BACKEND = (import.meta.env.PUBLIC_BACKEND_URL as string) || '';
      const slug = root.dataset.slug || '';
      // Poll
      const opts = root.querySelectorAll<HTMLElement>('.poll-opt');
      const msg = document.getElementById('poll-msg');
      function render(votes: Record<string, number>) {
        const total = (votes.home || 0) + (votes.draw || 0) + (votes.away || 0);
        opts.forEach((o) => {
          const k = o.dataset.opt || '';
          const n = votes[k] || 0;
          const pct = total ? Math.round((n / total) * 100) : 0;
          let fill = o.querySelector<HTMLElement>('.poll-fill');
          if (!fill) {
            fill = document.createElement('span');
            fill.className = 'poll-fill';
            o.prepend(fill);
          }
          fill.style.width = pct + '%';
          let pc = o.querySelector<HTMLElement>('.poll-pct');
          if (!pc) {
            pc = document.createElement('span');
            pc.className = 'poll-pct';
            o.appendChild(pc);
          }
          pc.textContent = pct + '%';
        });
        if (msg) msg.textContent = `${total} vote${total === 1 ? '' : 's'} so far`;
      }
      async function loadPoll() {
        try {
          const r = await fetch(`${BACKEND}/api/poll/${slug}`);
          const d = await r.json();
          render(d.votes || {});
        } catch (e) {}
      }
      opts.forEach((o) =>
        o.addEventListener('click', async () => {
          try {
            const r = await fetch(`${BACKEND}/api/poll/vote`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ matchSlug: slug, option: o.dataset.opt }),
            });
            const d = await r.json();
            render(d.votes || {});
            opts.forEach((x) => (x.style.opacity = '0.7'));
            o.style.opacity = '1';
          } catch (e) {
            if (msg) msg.textContent = 'Could not register vote.';
          }
        })
      );
      loadPoll();
    }
    bindLiveScreen();
    document.addEventListener('astro:after-swap', bindLiveScreen);
  </script>
</BaseLayout>
