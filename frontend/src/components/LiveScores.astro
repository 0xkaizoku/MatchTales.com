---
// Live scores widget — pulls server-side proxied Football-Data.org competitions.
---
<div data-testid="live-scores" class="rounded-card border border-border/80 bg-surface shadow-card overflow-hidden">
  <div class="flex items-center justify-between px-4 py-3 border-b border-border/70">
    <h3 class="font-head font-semibold flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-coral pulse-glow"></span> Live Football Feed</h3>
    <span class="text-[11px] text-muted font-sans">via Football-Data</span>
  </div>
  <div id="live-feed" class="divide-y divide-border/60 font-sans">
    <div class="px-4 py-5 text-sm text-muted text-center">Connecting to live feed…</div>
  </div>
  <p class="text-[11px] text-muted px-4 py-2.5 border-t border-border/60 font-sans">Real-time competitions from around the world. WC2026 narratives are curated by MatchTales.</p>
</div>
<script>
  function bindLive() {
    const feed = document.getElementById('live-feed');
    if (!feed || feed.dataset.bound) return; feed.dataset.bound = '1';
    const BACKEND = (import.meta.env.PUBLIC_BACKEND_URL) || '';
    (async () => {
      try {
        const r = await fetch(`${BACKEND}/api/live-scores`);
        if (!r.ok) throw new Error('bad');
        const d = await r.json();
        const comps = d.competitions || [];
        if (!comps.length) { feed.innerHTML = '<div class="px-4 py-5 text-sm text-muted text-center">No live competitions right now.</div>'; return; }
        feed.innerHTML = comps.map((c) => `<div class="flex items-center gap-3 px-4 py-3">${c.emblem ? `<img src=\"${c.emblem}\" alt=\"\" width=\"24\" height=\"24\" class=\"w-6 h-6 object-contain\" loading=\"lazy\"/>` : ''}<span class="flex-1 min-w-0"><span class="block text-sm font-medium truncate">${c.name}</span><span class="block text-[11px] text-muted">${c.area}${c.currentMatchday ? ' · MD ' + c.currentMatchday : ''}</span></span></div>`).join('');
      } catch (e) {
        feed.innerHTML = '<div class="px-4 py-5 text-sm text-muted text-center">Live feed unavailable right now.</div>';
      }
    })();
  }
  bindLive();
  document.addEventListener('astro:after-swap', bindLive);
</script>
