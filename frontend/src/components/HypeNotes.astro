---
import { dict, localeFromPath } from '../i18n';
import type { Locale } from '../i18n';
export interface Props { matchSlug?: string; matchLabel?: string; compact?: boolean; }
const locale = (Astro.locals?.locale || localeFromPath(Astro.url.pathname)) as Locale;
const d = dict(locale);
const { matchSlug = '', matchLabel = '', compact = false } = Astro.props;
---
<div data-testid="hype-notes" data-match-slug={matchSlug} data-match-label={matchLabel} class="grid gap-6 lg:grid-cols-5"
  data-loading={d.hype.loading} data-empty={d.hype.empty} data-error={d.hype.error} data-posted={d.hype.posted}
  data-posting={d.hype.posting} data-post={d.hype.post} data-anon={d.hype.anonymous} data-fail={d.hype.couldNotPost} data-network={d.hype.network}>
  <div class={compact ? 'lg:col-span-5' : 'lg:col-span-2'}>
    <form id="hype-form" data-testid="hype-note-form" class="rounded-card border border-border/80 bg-surface p-5 shadow-card">
      <h3 class="font-head text-lg font-semibold">{d.hype.dropTitle}</h3>
      <p class="text-sm text-muted font-sans mt-1">{d.hype.dropBlurb}</p>
      <input name="name" maxlength="40" data-testid="hype-name-input" placeholder={d.hype.namePh} class="mt-4 h-11 w-full rounded-btn border border-border bg-bg px-3.5 font-sans text-sm outline-none focus-visible:ring-2 focus-visible:ring-sky" />
      <textarea name="text" required maxlength="400" rows="3" data-testid="hype-text-input" placeholder={d.hype.textPh} class="mt-3 w-full rounded-btn border border-border bg-bg px-3.5 py-2.5 font-sans text-sm outline-none focus-visible:ring-2 focus-visible:ring-sky resize-none"></textarea>
      <div class="mt-3 flex items-center justify-between gap-3">
        <span class="text-[11px] text-muted font-sans">{d.hype.kind}</span>
        <button type="submit" data-testid="hype-submit-button" class="h-10 rounded-btn bg-pitch px-4 font-sans font-medium text-white hover:bg-pitch2 transition-colors">{d.hype.post}</button>
      </div>
      <p id="hype-msg" class="hidden mt-2 text-sm font-sans"></p>
    </form>
  </div>
  <div class={compact ? 'lg:col-span-5' : 'lg:col-span-3'}>
    <div id="hype-feed" data-testid="hype-feed" class="grid sm:grid-cols-2 gap-3">
      <div class="text-sm text-muted font-sans col-span-full py-6 text-center">{d.hype.loading}</div>
    </div>
  </div>
</div>
<script>
  function bindHype() {
    const root = document.querySelector('[data-testid="hype-notes"]');
    if (!root || root.dataset.bound) return; root.dataset.bound = '1';
    const BACKEND = (import.meta.env.PUBLIC_BACKEND_URL) || '';
    const matchSlug = root.dataset.matchSlug || '';
    const matchLabel = root.dataset.matchLabel || '';
    const feed = document.getElementById('hype-feed');
    const esc = (s) => (s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    async function load() {
      try {
        const q = matchSlug ? `?matchSlug=${encodeURIComponent(matchSlug)}&limit=12` : '?limit=12';
        const r = await fetch(`${BACKEND}/api/hype-notes${q}`);
        const notes = await r.json();
        if (!Array.isArray(notes) || !notes.length) { feed.innerHTML = `<div class="text-sm text-muted font-sans col-span-full py-6 text-center">${root.dataset.empty || ''}</div>`; return; }
        feed.innerHTML = notes.map((n) => `<div class="rounded-card border border-border/70 bg-surface p-4" data-testid="hype-note-item"><p class="font-sans text-sm">“${esc(n.text)}”</p><div class="mt-2 flex items-center justify-between"><span class="text-[12px] font-sans font-medium text-pitch">${esc(n.name)}</span>${n.matchLabel ? `<span class=\"text-[11px] text-muted font-sans\">${esc(n.matchLabel)}</span>` : ''}</div></div>`).join('');
      } catch (e) { feed.innerHTML = `<div class="text-sm text-danger font-sans col-span-full py-6 text-center">${root.dataset.error || ''}</div>`; }
    }
    const f = document.getElementById('hype-form');
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = document.getElementById('hype-msg');
      const btn = f.querySelector('button');
      const body = { name: f.name.value.trim() || (root.dataset.anon || 'Anonymous'), text: f.text.value.trim(), matchSlug: matchSlug || null, matchLabel: matchLabel || null };
      btn.disabled = true; btn.textContent = root.dataset.posting || '';
      try {
        const r = await fetch(`${BACKEND}/api/hype-notes`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        const d = await r.json();
        if (r.ok) { msg.textContent = root.dataset.posted || ''; msg.className = 'mt-2 text-sm font-sans text-pitch'; f.reset(); load(); }
        else { msg.textContent = d.detail || root.dataset.fail || ''; msg.className = 'mt-2 text-sm font-sans text-danger'; }
      } catch (err) { msg.textContent = root.dataset.network || ''; msg.className = 'mt-2 text-sm font-sans text-danger'; }
      finally { msg.classList.remove('hidden'); btn.disabled = false; btn.textContent = root.dataset.post || ''; }
    });
    load();
  }
  bindHype();
  document.addEventListener('astro:after-swap', bindHype);
</script>
