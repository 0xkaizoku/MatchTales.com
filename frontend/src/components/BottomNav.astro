---
const path = Astro.url.pathname;
const items = [
  { href: '/', label: 'Home', id: 'home', icon: 'M3 11.5 12 4l9 7.5M5 10v10h14V10' },
  { href: '/fixtures', label: 'Fixtures', id: 'fixtures', icon: 'M8 2v4M16 2v4M3 9h18M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z' },
  { href: '/live', label: 'Live', id: 'live', icon: 'M12 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0-6 0M5 5a10 10 0 0 0 0 14M19 5a10 10 0 0 1 0 14' },
  { href: '/teams', label: 'Teams', id: 'teams', icon: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8' },
  { href: '/stories', label: 'Stories', id: 'stories', icon: 'M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 19.5A2.5 2.5 0 0 0 6.5 22H20V2H6.5A2.5 2.5 0 0 0 4 4.5v15Z' },
];
const active = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<nav class="fixed bottom-0 left-0 right-0 z-50 md:hidden border-t border-border/70 bg-surface/90 backdrop-blur supports-[backdrop-filter]:bg-surface/85" aria-label="Mobile">
  <div class="grid grid-cols-5">
    {items.map((it) => (
      <a href={it.href} data-testid={`bottomnav-${it.id}`} class={`flex flex-col items-center gap-0.5 py-2.5 text-[11px] font-sans transition-colors ${active(it.href) ? 'text-pitch' : 'text-muted'}`} aria-current={active(it.href) ? 'page' : undefined}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={it.icon}/></svg>
        <span>{it.label}</span>
      </a>
    ))}
  </div>
</nav>
