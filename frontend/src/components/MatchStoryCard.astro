---
import WhyCareMeter from './WhyCareMeter.astro';
import CompetitorMark from './CompetitorMark.astro';
import SportChip from './SportChip.astro';
import { contentImage, imgOnError, sportOf } from '../lib/site';
import { dict, localeFromPath, localePath } from '../i18n';
import { localizeMatch, fmtDateI18n, statusLabelI18n, scoreDisplayI18n } from '../i18n/content';
import type { Locale } from '../i18n';

export interface Props {
  m: any;
  featured?: boolean;
  compact?: boolean;
  eager?: boolean;
}
const locale = (Astro.locals?.locale || localeFromPath(Astro.url.pathname)) as Locale;
const d = dict(locale);
const { m, compact = false, eager = false } = Astro.props;
const raw = m.data || m;
const locm = localizeMatch(raw, locale);
const isLive = locm.status === 'LIVE';
const isFinished = locm.status === 'FINISHED';
const score = scoreDisplayI18n(locale, locm);
const sport = sportOf(locm);
const stage = locm._stage || locm.roundLabel;
const img = !compact ? contentImage(locm.image, locm.slug, 640, 72) : '';
const showImage = Boolean(img) && !compact;
const href = localePath(locale, `/match/${locm.slug}`);
---
<a
  href={href}
  data-testid="match-story-card"
  class:list={[
    'group block rounded-card border border-border/80 bg-surface shadow-card hover:shadow-cardhover transition-shadow duration-200 h-full overflow-hidden',
    compact && 'p-0',
  ]}
>
  {showImage && (
    <div class="aspect-[16/9] overflow-hidden bg-surface2">
      <img
        src={img}
        alt={`${locm.home} ${d.common.vs} ${locm.away}`}
        width="640"
        height="360"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : 'auto'}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        onerror={imgOnError(locm.slug)}
      />
    </div>
  )}
  <div class:list={['p-4 sm:p-5', compact && 'py-3.5']}>
    <div class="flex items-center justify-between gap-2 mb-2">
      <span class="inline-flex items-center gap-1.5 text-[11px] font-sans font-medium text-muted">
        <SportChip sport={sport} compact link={false} />
        <span class="rounded-full bg-surface2 px-2 py-0.5">{stage}</span>
        {locm.matchday > 0 && locm.matchday <= 3 ? <span>{d.stage.matchday.replace('{n}', String(locm.matchday))}</span> : null}
      </span>
      {isLive ? (
        <span class="inline-flex items-center gap-1.5 text-[11px] font-sans font-semibold text-coral"><span class="w-2 h-2 rounded-full bg-coral pulse-glow"></span>{d.status.LIVE}</span>
      ) : (
        <span class="text-[11px] font-sans text-muted">{statusLabelI18n(locale, locm.status)}</span>
      )}
    </div>

    <div class="flex items-center justify-between gap-3">
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2">
          <CompetitorMark name={raw.home} code={locm.homeCode} sport={sport} size="sm" />
          <span class="font-head font-semibold truncate text-[15px] sm:text-base">{locm.home}</span>
        </div>
        <div class="flex items-center gap-2 mt-1">
          <CompetitorMark name={raw.away} code={locm.awayCode} sport={sport} size="sm" />
          <span class="font-head font-semibold truncate text-[15px] sm:text-base">{locm.away}</span>
        </div>
      </div>
      {(isFinished || isLive) && score && (
        <div class="text-right font-head font-bold text-xl sm:text-2xl tabular-nums leading-tight score-block">
          <div>{locm.homeScore}</div>
          <div>{locm.awayScore}</div>
          {score.note && <div class="text-[10px] font-sans font-medium text-muted mt-0.5 normal-case tracking-normal">{score.note}</div>}
        </div>
      )}
    </div>

    {!compact && (
      <>
        <h3 class="mt-3 font-head text-lg leading-snug tracking-tight group-hover:underline decoration-pitch decoration-2 underline-offset-4">{locm.headline}</h3>
        <p class="mt-1.5 text-sm text-muted line-clamp-2 font-sans">{locm.teaser}</p>
      </>
    )}
    {compact && (
      <p class="mt-1.5 text-sm text-muted line-clamp-1 font-sans">{locm.headline}</p>
    )}

    <div class="mt-3 flex items-center justify-between gap-3 border-t border-border/60 pt-2.5">
      <WhyCareMeter score={locm.whyCareScore} size="sm" />
      <span class="text-[11px] text-muted font-sans whitespace-nowrap">{fmtDateI18n(locale, locm.date)} · {locm.time}</span>
    </div>
  </div>
</a>
