---
import WhyCareMeter from './WhyCareMeter.astro';
import CompetitorMark from './CompetitorMark.astro';
import SportChip from './SportChip.astro';
import { fmtDate, statusLabel, stageLabel, scoreDisplay, contentImage, imgOnError, sportOf } from '../lib/site';
export interface Props {
  m: any;
  featured?: boolean;
  /** Compact list row: no hero image (much smaller HTML / faster). */
  compact?: boolean;
  /** Eager-load first visible cards. */
  eager?: boolean;
}
const { m, featured = false, compact = false, eager = false } = Astro.props;
const d = m.data || m;
const isLive = d.status === 'LIVE';
const isFinished = d.status === 'FINISHED';
const score = scoreDisplay(d);
const sport = sportOf(d);
const stage = stageLabel(d.group, d.roundLabel);
const img = !compact ? contentImage(d.image, d.slug, 640, 72) : '';
const showImage = Boolean(img) && !compact;
---
<a
  href={`/match/${d.slug}`}
  data-testid="match-story-card"
  class:list={[
    'group block rounded-card border border-border/80 bg-surface shadow-card hover:shadow-cardhover transition-shadow duration-200 h-full overflow-hidden',
    compact && 'p-0',
  ]}
>
  {showImage && (
    <div class="aspect-[16/9] overflow-hidden bg-surface2">
      <img
        src={img}
        alt={`${d.home} vs ${d.away}`}
        width="640"
        height="360"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : 'auto'}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        onerror={imgOnError(d.slug)}
      />
    </div>
  )}
  <div class:list={['p-4 sm:p-5', compact && 'py-3.5']}>
    <div class="flex items-center justify-between gap-2 mb-2">
      <span class="inline-flex items-center gap-1.5 text-[11px] font-sans font-medium text-muted">
        <SportChip sport={sport} compact link={false} />
        <span class="rounded-full bg-surface2 px-2 py-0.5">{stage}</span>
        {d.matchday > 0 && d.matchday <= 3 ? <span>MD{d.matchday}</span> : null}
      </span>
      {isLive ? (
        <span class="inline-flex items-center gap-1.5 text-[11px] font-sans font-semibold text-coral"><span class="w-2 h-2 rounded-full bg-coral pulse-glow"></span>LIVE</span>
      ) : (
        <span class="text-[11px] font-sans text-muted">{statusLabel(d.status)}</span>
      )}
    </div>

    <div class="flex items-center justify-between gap-3">
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2">
          <CompetitorMark name={d.home} code={d.homeCode} sport={sport} size="sm" />
          <span class="font-head font-semibold truncate text-[15px] sm:text-base">{d.home}</span>
        </div>
        <div class="flex items-center gap-2 mt-1">
          <CompetitorMark name={d.away} code={d.awayCode} sport={sport} size="sm" />
          <span class="font-head font-semibold truncate text-[15px] sm:text-base">{d.away}</span>
        </div>
      </div>
      {(isFinished || isLive) && score && (
        <div class="text-right font-head font-bold text-xl sm:text-2xl tabular-nums leading-tight score-block">
          <div>{d.homeScore}</div>
          <div>{d.awayScore}</div>
          {score.note && <div class="text-[10px] font-sans font-medium text-muted mt-0.5 normal-case tracking-normal">{score.note}</div>}
        </div>
      )}
    </div>

    {!compact && (
      <>
        <h3 class="mt-3 font-head text-lg leading-snug tracking-tight group-hover:underline decoration-pitch decoration-2 underline-offset-4">{d.headline}</h3>
        <p class="mt-1.5 text-sm text-muted line-clamp-2 font-sans">{d.teaser}</p>
      </>
    )}
    {compact && (
      <p class="mt-1.5 text-sm text-muted line-clamp-1 font-sans">{d.headline}</p>
    )}

    <div class="mt-3 flex items-center justify-between gap-3 border-t border-border/60 pt-2.5">
      <WhyCareMeter score={d.whyCareScore} size="sm" />
      <span class="text-[11px] text-muted font-sans whitespace-nowrap">{fmtDate(d.date)} · {d.time}</span>
    </div>
  </div>
</a>
