---
/** Quiet numeric rating. Data still lives on whyCareScore; the old meter label is gone. */
export interface Props { score: number; size?: 'sm' | 'md' | 'lg'; showLabel?: boolean; }
const { score, size = 'md' } = Astro.props;
const num = size === 'lg' ? 'text-2xl' : size === 'sm' ? 'text-sm' : 'text-lg';
---
<span class={`font-head font-semibold tabular-nums leading-none ${num}`} data-testid="rating">{score.toFixed(1)}</span>
