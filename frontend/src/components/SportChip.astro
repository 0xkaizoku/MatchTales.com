---
import { sportBySlug, sportOf } from '../data/sports';
import { localeFromPath, localePath, sportCopy } from '../i18n';
import type { Locale } from '../i18n';

export interface Props {
  sport?: string;
  compact?: boolean;
  link?: boolean;
}
const locale = (Astro.locals?.locale || localeFromPath(Astro.url.pathname)) as Locale;
const { sport, compact = false, link = true } = Astro.props;
const meta = sportBySlug(sportOf({ sport }));
const label = meta ? sportCopy(locale, meta.slug).label : '';
const href = meta ? localePath(locale, meta.href) : '#';
const cls = [
  'inline-flex items-center rounded-full font-sans font-medium',
  compact ? 'bg-surface2 px-2 py-0.5 text-[10px] text-muted' : 'border border-border px-2.5 py-1 text-[11px] text-muted',
  link ? 'hover:bg-surface2 transition-colors' : '',
].filter(Boolean).join(' ');
---
{meta && link && (
  <a href={href} class={cls}>{label}</a>
)}
{meta && !link && (
  <span class={cls}>{label}</span>
)}
