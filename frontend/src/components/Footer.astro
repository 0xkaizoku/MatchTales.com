---
import { dict, localeFromPath, localePath } from '../i18n';
import type { Locale } from '../i18n';
import { fill } from '../i18n/locales';

const locale = (Astro.locals?.locale || localeFromPath(Astro.url.pathname)) as Locale;
const d = dict(locale);
const year = new Date().getFullYear();
const lp = (p: string) => localePath(locale, p);
---
<footer class="border-t border-border/70 bg-surface mt-16">
  <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid gap-8 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2">
          <span class="grid place-items-center w-8 h-8 rounded-btn bg-pitch text-white font-head font-bold">M</span>
          <span class="font-head text-lg font-semibold">MatchTales</span>
        </div>
        <p class="mt-3 text-sm text-muted max-w-sm font-sans">{d.footer.blurb}</p>
      </div>
      <div>
        <h4 class="font-head text-sm font-semibold mb-3">{d.footer.explore}</h4>
        <ul class="space-y-2 text-sm font-sans text-muted">
          <li><a href={lp('/sports')} data-astro-prefetch class="hover:text-fg">{d.footer.directory}</a></li>
          <li><a href={lp('/sport/tennis')} data-astro-prefetch class="hover:text-fg">{d.sports.tennis.label}</a></li>
          <li><a href={lp('/sport/football')} data-astro-prefetch class="hover:text-fg">{d.sports.football.label}</a></li>
          <li><a href={lp('/sport/f1')} data-astro-prefetch class="hover:text-fg">{d.sports.f1.label}</a></li>
          <li><a href={lp('/sport/soccer')} data-astro-prefetch class="hover:text-fg">{d.sports.soccer.label}</a></li>
          <li><a href={lp('/sport/golf')} data-astro-prefetch class="hover:text-fg">{d.sports.golf.label}</a></li>
          <li><a href={lp('/sport/basketball')} data-astro-prefetch class="hover:text-fg">{d.sports.basketball.label}</a></li>
          <li><a href={lp('/world-cup')} data-astro-prefetch class="hover:text-fg">{d.footer.worldCup}</a></li>
          <li><a href={lp('/stories')} data-astro-prefetch class="hover:text-fg">{d.nav.stories}</a></li>
          <li><a href={lp('/live')} class="hover:text-fg">{d.nav.live}</a></li>
          <li><a href={lp('/rss.xml')} class="hover:text-fg">{d.footer.rss}</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-head text-sm font-semibold mb-3">{d.footer.about}</h4>
        <ul class="space-y-2 text-sm font-sans text-muted">
          <li><a href={lp('/about')} class="hover:text-fg">{d.footer.mission}</a></li>
          <li><a href={lp('/privacy')} class="hover:text-fg">{d.footer.privacy}</a></li>
          <li><a href={lp('/') + '#newsletter'} class="hover:text-fg">{d.footer.newsletter}</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-10 pt-6 border-t border-border/70 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <p class="text-xs text-muted font-sans">{fill(d.footer.legal, { year })}</p>
      <div class="flex items-center gap-3 text-muted">
        <a href="https://x.com/matchtales" rel="noopener noreferrer" target="_blank" aria-label="MatchTales on X" class="hover:text-fg"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 1.2h3.7l-8 9.1L24 22.8h-7.4l-5.8-7.6-6.6 7.6H.4l8.6-9.8L0 1.2h7.6l5.2 6.9 6.1-6.9Zm-1.3 19.4h2L6.5 3.3H4.3l13.3 17.3Z"/></svg></a>
      </div>
    </div>
  </div>
</footer>
