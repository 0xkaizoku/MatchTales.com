---
const year = new Date().getFullYear();
---
<footer class="border-t border-border/70 bg-surface mt-16">
  <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid gap-8 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2">
          <span class="grid place-items-center w-8 h-8 rounded-btn bg-pitch text-white font-head font-bold">M</span>
          <span class="font-head text-lg font-semibold">MatchTales</span>
        </div>
        <p class="mt-3 text-sm text-muted max-w-sm font-sans">The story layer on top of the score. We tell you <em>why this match matters</em>: the rivalries, the legacies, the heartbreak and the hype, across six sports.</p>
      </div>
      <div>
        <h4 class="font-head text-sm font-semibold mb-3">Explore</h4>
        <ul class="space-y-2 text-sm font-sans text-muted">
          <li><a href="/sports" data-astro-prefetch class="hover:text-fg">Sports directory</a></li>
          <li><a href="/sport/tennis" data-astro-prefetch class="hover:text-fg">Tennis</a></li>
          <li><a href="/sport/football" data-astro-prefetch class="hover:text-fg">Football</a></li>
          <li><a href="/sport/f1" data-astro-prefetch class="hover:text-fg">Formula 1</a></li>
          <li><a href="/sport/soccer" data-astro-prefetch class="hover:text-fg">Soccer</a></li>
          <li><a href="/sport/golf" data-astro-prefetch class="hover:text-fg">Golf</a></li>
          <li><a href="/sport/basketball" data-astro-prefetch class="hover:text-fg">Basketball</a></li>
          <li><a href="/world-cup" data-astro-prefetch class="hover:text-fg">World Cup archive</a></li>
          <li><a href="/stories" data-astro-prefetch class="hover:text-fg">Stories</a></li>
          <li><a href="/live" class="hover:text-fg">Live</a></li>
          <li><a href="/rss.xml" class="hover:text-fg">RSS</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-head text-sm font-semibold mb-3">About</h4>
        <ul class="space-y-2 text-sm font-sans text-muted">
          <li><a href="/about" class="hover:text-fg">Our Mission</a></li>
          <li><a href="/privacy" class="hover:text-fg">Privacy Policy</a></li>
          <li><a href="/#newsletter" class="hover:text-fg">Newsletter</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-10 pt-6 border-t border-border/70 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <p class="text-xs text-muted font-sans">© {year} MatchTales. An independent fan project, not affiliated with FIFA, the NFL, NBA, WNBA, ATP, WTA, PGA Tour or Formula 1. Names and marks belong to their owners.</p>
      <div class="flex items-center gap-3 text-muted">
        <a href="https://x.com/matchtales" rel="noopener noreferrer" target="_blank" aria-label="MatchTales on X" class="hover:text-fg"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 1.2h3.7l-8 9.1L24 22.8h-7.4l-5.8-7.6-6.6 7.6H.4l8.6-9.8L0 1.2h7.6l5.2 6.9 6.1-6.9Zm-1.3 19.4h2L6.5 3.3H4.3l13.3 17.3Z"/></svg></a>
      </div>
    </div>
  </div>
</footer>
