---
const year = new Date().getFullYear();
---
<footer class="border-t border-border/70 bg-surface mt-16">
  <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid gap-8 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2">
          <span class="grid place-items-center w-8 h-8 rounded-btn bg-pitch text-white font-head font-bold">M</span>
          <span class="font-head text-lg font-semibold">MatchTales</span>
        </div>
        <p class="mt-3 text-sm text-muted max-w-sm font-sans">The story layer on top of the 2026 FIFA World Cup. We tell you <em>why this match matters</em> — the rivalries, the legacies, the heartbreak and the hype.</p>
      </div>
      <div>
        <h4 class="font-head text-sm font-semibold mb-3">Explore</h4>
        <ul class="space-y-2 text-sm font-sans text-muted">
          <li><a href="/fixtures" class="hover:text-fg">Fixtures</a></li>
          <li><a href="/groups" class="hover:text-fg">Groups</a></li>
          <li><a href="/teams" class="hover:text-fg">Teams</a></li>
          <li><a href="/stories" class="hover:text-fg">Stories</a></li>
          <li><a href="/live" class="hover:text-fg">Live</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-head text-sm font-semibold mb-3">About</h4>
        <ul class="space-y-2 text-sm font-sans text-muted">
          <li><a href="/about" class="hover:text-fg">Our Mission</a></li>
          <li><a href="/privacy" class="hover:text-fg">Privacy Policy</a></li>
          <li><a href="/#newsletter" class="hover:text-fg">Newsletter</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-10 pt-6 border-t border-border/70 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <p class="text-xs text-muted font-sans">© {year} MatchTales. An independent fan project — not affiliated with or endorsed by FIFA. All team names are property of their respective owners.</p>
      <div class="flex items-center gap-3 text-muted">
        <a href="#" aria-label="Twitter" class="hover:text-fg"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 1.2h3.7l-8 9.1L24 22.8h-7.4l-5.8-7.6-6.6 7.6H.4l8.6-9.8L0 1.2h7.6l5.2 6.9 6.1-6.9Zm-1.3 19.4h2L6.5 3.3H4.3l13.3 17.3Z"/></svg></a>
        <a href="#" aria-label="Instagram" class="hover:text-fg"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
      </div>
    </div>
  </div>
</footer>
