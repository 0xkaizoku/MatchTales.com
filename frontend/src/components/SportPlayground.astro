---
import desk from '../data/desk.json';
import type { SportSlug } from '../data/sports';
import { entityName, localeFromPath, localePath, playgroundCopy } from '../i18n';
import type { Locale } from '../i18n';

export interface Props {
  sport: SportSlug;
  locale?: Locale;
}

const { sport, locale: propLocale } = Astro.props;
const locale = (propLocale || Astro.locals?.locale || localeFromPath(Astro.url.pathname) || 'en') as Locale;
const copy = playgroundCopy(locale);
const lp = (p: string) => localePath(locale, p);

const maxPts = desk.f1Drivers[0]?.pts || 292;
const maxCtor = desk.f1Constructors[0]?.pts || 503;
const tennisDraw = [
  { draw: copy.men, p1: 'Alexander Zverev', p2: 'Ben Shelton', href: lp('/match/zverev-vs-shelton-uso-final'), note: 'Zverev 6-3, 7-6 (2), 5-7, 6-2. Second Slam of 2026. First US Open.' },
  { draw: copy.men, p1: 'Carlos Alcaraz', p2: 'Ben Shelton', href: lp('/match/alcaraz-vs-shelton-uso-qf'), note: 'Shelton 6-7 (5), 6-1, 6-3, 1-6, 7-6 (10-7). Finished 3:33 a.m., latest in US Open history.' },
  { draw: copy.women, p1: 'Elena Rybakina', p2: 'Aryna Sabalenka', href: lp('/match/rybakina-vs-sabalenka-uso-final'), note: 'Rybakina 6-4, 5-7, 6-2. New world No. 1. Three-peat stopped.' },
  { draw: copy.women, p1: 'Aryna Sabalenka', p2: 'Linda Noskova', href: lp('/match/sabalenka-vs-noskova-uso-qf'), note: 'Sabalenka 7-6 (7-1), 3-6, 7-6 (10-7). Then lost the final to Rybakina.' },
];
const men = tennisDraw.filter((q) => q.draw === copy.men);
const women = tennisDraw.filter((q) => q.draw === copy.women);
const nflLinks: Record<string, string> = {
  '2026-09-09': lp('/match/patriots-at-seahawks-kickoff-2026'),
  '2026-09-10': lp('/match/49ers-vs-rams-melbourne-2026'),
  '2026-09-14': lp('/match/broncos-at-chiefs-mnf-2026'),
  '2026-09-17': lp('/match/lions-at-bills-tnf-2026'),
  '2026-09-20': lp('/match/colts-at-chiefs-week2-2026'),
  '2026-09-21': lp('/match/rams-vs-giants-week2-2026'),
  '2026-09-24': lp('/match/falcons-at-packers-week3-2026'),
};
const hoopsPairs = [
  { a: desk.wnbaSeeds[0], b: desk.wnbaSeeds[7] },
  { a: desk.wnbaSeeds[1], b: desk.wnbaSeeds[6] },
  { a: desk.wnbaSeeds[2], b: desk.wnbaSeeds[5] },
  { a: desk.wnbaSeeds[3], b: desk.wnbaSeeds[4] },
];
---
<div class={`pg pg-${sport}`} data-playground={sport}>
  {sport === 'tennis' && (
    <section class="pg-frame">
      <div class="pg-head">
        <div>
          <h2 class="font-head text-xl font-semibold tracking-tight">{copy.champions}</h2>
          <p class="text-sm text-muted font-sans mt-1">{copy.pinFinal}</p>
        </div>
        <span class="pg-live">{copy.openClosed}</span>
      </div>
      <div class="court-board">
        <div class="draw-col">
          <p class="draw-label">{copy.men}</p>
          {men.map((q) => (
            <button type="button" class="draw-slot" data-note={q.note} data-href={q.href}>
              <span class="draw-names">{q.p1}</span>
              <span class="draw-vs">vs</span>
              <span class="draw-names">{q.p2}</span>
            </button>
          ))}
        </div>
        <div class="court-net" aria-hidden="true"><span></span></div>
        <div class="draw-col">
          <p class="draw-label">{copy.women}</p>
          {women.map((q) => (
            <button type="button" class="draw-slot" data-note={q.note} data-href={q.href}>
              <span class="draw-names">{q.p1}</span>
              <span class="draw-vs">vs</span>
              <span class="draw-names">{q.p2}</span>
            </button>
          ))}
        </div>
      </div>
      <div class="pg-panel" data-panel hidden>
        <p class="pg-panel-note"></p>
        <a class="pg-panel-link" href="#">{copy.readWhy}</a>
      </div>
    </section>
  )}

  {sport === 'football' && (
    <section class="pg-frame field-frame">
      <div class="pg-head">
        <div>
          <h2 class="font-head text-xl font-semibold tracking-tight">{copy.week1Closed}</h2>
          <p class="text-sm text-muted font-sans mt-1">{copy.week1Sub}</p>
        </div>
      </div>
      <div class="field-board">
        <svg class="field-lines" viewBox="0 0 640 220" aria-hidden="true">
          <rect x="8" y="8" width="624" height="204" rx="10" fill="none" stroke="currentColor" />
          <line x1="320" y1="8" x2="320" y2="212" />
          {Array.from({ length: 9 }).map((_, i) => (
            <line x1={64 + i * 64} y1="8" x2={64 + i * 64} y2="212" opacity="0.35" />
          ))}
        </svg>
        <div class="kick-clock">
          <p class="text-[11px] font-sans uppercase tracking-wide text-muted">{copy.countdownTnf}</p>
          <p id="nfl-clock" class="font-head text-4xl sm:text-5xl tabular-nums tracking-tight">41-31</p>
        </div>
      </div>
      <ol class="slate">
        {desk.nflWeek1.map((g) => {
          const href = nflLinks[g.date];
          const Tag = href ? 'a' : 'div';
          return (
            <li>
              <Tag href={href} class="slate-row">
                <span class="slate-when">{g.date} · {g.time}</span>
                <span class="slate-who font-head font-semibold">{entityName(g.away, locale)} {locale === 'en' ? 'at' : 'vs'} {entityName(g.home, locale)}</span>
                <span class="slate-note">{g.note}</span>
              </Tag>
            </li>
          );
        })}
      </ol>
    </section>
  )}

  {sport === 'f1' && (
    <section class="pg-frame grid-frame">
      <div class="pg-head">
        <div>
          <h2 class="font-head text-xl font-semibold tracking-tight">{copy.gridAfterMadrid}</h2>
          <p class="text-sm text-muted font-sans mt-1">{copy.barsPoints}</p>
        </div>
        <div class="seg" role="tablist" aria-label="Championship">
          <button type="button" class="seg-btn is-on" data-tab="drivers">{copy.drivers}</button>
          <button type="button" class="seg-btn" data-tab="constructors">{copy.constructors}</button>
        </div>
      </div>
      <div class="f1-arm">
        <div class="f1-lights" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <button type="button" class="arm-btn" data-arm>{copy.armBaku}</button>
      </div>
      <div data-pane="drivers" class="grid-pane">
        {desk.f1Drivers.map((r) => (
          <div class="grid-row">
            <span class="grid-pos tabular-nums">{r.pos}</span>
            <span class="min-w-0"><span class="font-head font-semibold">{r.name}</span> <span class="text-muted text-sm">{entityName(r.team, locale)}</span></span>
            <span class="tabular-nums font-head">{r.pts}</span>
            <div class="grid-track"><div class="bar-fill" style={`--p:${r.pts / maxPts}`}></div></div>
          </div>
        ))}
      </div>
      <div data-pane="constructors" class="grid-pane" hidden>
        {desk.f1Constructors.map((r) => (
          <div class="grid-row">
            <span class="grid-pos tabular-nums">{r.pos}</span>
            <span class="font-head font-semibold">{entityName(r.name, locale)}</span>
            <span class="tabular-nums font-head">{r.pts}</span>
            <div class="grid-track"><div class="bar-fill" style={`--p:${r.pts / maxCtor}`}></div></div>
          </div>
        ))}
      </div>
    </section>
  )}

  {sport === 'soccer' && (
    <section class="pg-frame pitch-frame">
      <div class="pg-head">
        <div>
          <h2 class="font-head text-xl font-semibold tracking-tight">{copy.tableAfterMonday}</h2>
          <p class="text-sm text-muted font-sans mt-1">{copy.pinClub}</p>
        </div>
      </div>
      <div class="pl-table">
        {desk.premierLeagueTable.map((r) => (
          <button
            type="button"
            class="pl-row"
            data-note={`${entityName(r.team, locale)}: ${r.p} played, ${r.pts} points, GD ${r.gd > 0 ? '+' : ''}${r.gd}.`}
          >
            <span class="tabular-nums text-muted w-6">{r.pos}</span>
            <span class="flex-1 text-left font-head font-semibold">{entityName(r.team, locale)}</span>
            <span class="tabular-nums w-8 text-right">{r.pts}</span>
            <span class="pl-gd">
              <span class="bar-fill" style={`--p:${Math.min(1, Math.abs(r.gd) / 5)};${r.gd < 0 ? 'transform-origin:right center' : ''}`}></span>
            </span>
          </button>
        ))}
      </div>
      <p id="pl-note" class="pg-foot">{copy.plFootnote}</p>
      <p class="pg-archive">{copy.wcFinished} <a href={lp('/world-cup')}>{copy.archive}</a></p>
    </section>
  )}

  {sport === 'golf' && (
    <section class="pg-frame card-frame">
      <div class="pg-head">
        <div>
          <h2 class="font-head text-xl font-semibold tracking-tight">{copy.theBoard}</h2>
          <p class="text-sm text-muted font-sans mt-1">{copy.majorsDone}</p>
        </div>
      </div>
      <div class="scorecards">
        <a href={lp('/match/bmw-pga-wentworth-2026')} class="scorecard" data-note="JJ Spaun 271, seventeen under. AP: Elvira, McIlroy, Rai, Scott 273. Elvira double bogey on 18. Final.">
          <span class="score-event">BMW PGA · Wentworth</span>
          <span class="score-name">JJ Spaun</span>
          <span class="score-num">-17</span>
          <span class="score-line">271. Elvira T2 · McIlroy T2. Final.</span>
        </a>
        <a href={lp('/match/tour-championship-2026-east-lake')} class="scorecard" data-note="Scottie Scheffler 264, sixteen under. Hovland thirteen under. Second FedEx Cup.">
          <span class="score-event">Tour Championship · East Lake</span>
          <span class="score-name">Scottie Scheffler</span>
          <span class="score-num">-16</span>
          <span class="score-line">264. Hovland -13. Second FedEx Cup.</span>
        </a>
        <a href={lp('/match/presidents-cup-2026-medinah')} class="scorecard is-next" data-note="Presidents Cup, Medinah, 22-27 September. Official practice underway. Competition begins Thursday.">
          <span class="score-event">{copy.next}</span>
          <span class="score-name">Presidents Cup</span>
          <span class="score-num score-empty">{copy.tbd}</span>
          <span class="score-line">Medinah, 24-27 September. Practice rounds.</span>
        </a>
      </div>
      <p id="golf-note" class="pg-foot">{copy.golfFootnote}</p>
    </section>
  )}

  {sport === 'basketball' && (
    <section class="pg-frame floor-frame">
      <div class="pg-head">
        <div>
          <h2 class="font-head text-xl font-semibold tracking-tight">{copy.theBracket}</h2>
          <p class="text-sm text-muted font-sans mt-1">{copy.wnbaFirstRound}</p>
        </div>
      </div>
      <div class="bracket">
        {hoopsPairs.map((pair) => (
          <button
            type="button"
            class="series"
            data-note={`${entityName(pair.a.team, locale)} (${pair.a.record}) vs ${entityName(pair.b.team, locale)} (${pair.b.record}). First round. No series result yet.`}
          >
            <span class="seed-pill">
              <b>{pair.a.seed}</b>
              <span>{entityName(pair.a.team, locale)}</span>
              <em>{pair.a.record}</em>
            </span>
            <span class="series-vs">vs</span>
            <span class="seed-pill">
              <b>{pair.b.seed}</b>
              <span>{entityName(pair.b.team, locale)}</span>
              <em>{pair.b.record}</em>
            </span>
          </button>
        ))}
      </div>
      <p id="hoops-note" class="pg-foot">{copy.bracketFootnote}</p>
      <p class="pg-archive"><a href={lp('/match/nba-finals-2026-knicks-spurs')}>{copy.juneArchive}</a></p>
    </section>
  )}
</div>

<script>
  function bindPlaygrounds() {
    document.querySelectorAll('[data-playground]').forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.bound) return;
      root.dataset.bound = '1';
      const sport = root.dataset.playground;

      const setOn = (nodes: NodeListOf<Element>, el: Element) => {
        nodes.forEach((n) => n.classList.remove('is-on'));
        el.classList.add('is-on');
      };

      if (sport === 'tennis') {
        const panel = root.querySelector('[data-panel]');
        const noteEl = root.querySelector('.pg-panel-note');
        const linkEl = root.querySelector('.pg-panel-link');
        root.querySelectorAll('.draw-slot').forEach((row) => {
          row.addEventListener('click', () => {
            setOn(root.querySelectorAll('.draw-slot'), row);
            const note = row.getAttribute('data-note') || '';
            const href = row.getAttribute('data-href') || '#';
            if (noteEl) noteEl.textContent = note;
            if (linkEl instanceof HTMLAnchorElement) {
              linkEl.href = href;
              linkEl.hidden = false;
            }
            panel?.removeAttribute('hidden');
          });
        });
      }

      if (sport === 'football') {
        const el = document.getElementById('nfl-clock');
        if (el) el.textContent = '41-31';
        root.querySelectorAll('.slate-row').forEach((row) => {
          row.addEventListener('pointerenter', () => setOn(root.querySelectorAll('.slate-row'), row));
          row.addEventListener('focus', () => setOn(root.querySelectorAll('.slate-row'), row));
        });
      }

      if (sport === 'f1') {
        const tabs = root.querySelectorAll('.seg-btn');
        tabs.forEach((btn) => {
          btn.addEventListener('click', () => {
            const tab = btn.getAttribute('data-tab');
            tabs.forEach((t) => t.classList.toggle('is-on', t === btn));
            root.querySelectorAll('[data-pane]').forEach((pane) => {
              const on = pane.getAttribute('data-pane') === tab;
              (pane as HTMLElement).hidden = !on;
            });
          });
        });
        const lights = root.querySelector('.f1-lights');
        const arm = root.querySelector('[data-arm]');
        arm?.addEventListener('click', () => {
          if (!(lights instanceof HTMLElement) || !(arm instanceof HTMLButtonElement)) return;
          lights.classList.remove('is-go', 'is-out');
          void lights.offsetWidth;
          lights.classList.add('is-go');
          arm.disabled = true;
          window.setTimeout(() => {
            lights.classList.add('is-out');
            arm.disabled = false;
            arm.textContent = 'Lights out. Baku is next.';
          }, 1400);
        });
      }

      if (sport === 'soccer') {
        const pl = document.getElementById('pl-note');
        root.querySelectorAll('.pl-row').forEach((row) => {
          row.addEventListener('click', () => {
            setOn(root.querySelectorAll('.pl-row'), row);
            const note = row.getAttribute('data-note');
            if (note && pl) pl.textContent = note;
          });
        });
      }

      if (sport === 'golf') {
        const note = document.getElementById('golf-note');
        root.querySelectorAll('.scorecard').forEach((row) => {
          row.addEventListener('pointerenter', () => {
            setOn(root.querySelectorAll('.scorecard'), row);
            const n = row.getAttribute('data-note');
            if (n && note) note.textContent = n;
          });
        });
      }

      if (sport === 'basketball') {
        const hoops = document.getElementById('hoops-note');
        root.querySelectorAll('.series').forEach((row) => {
          row.addEventListener('click', () => {
            setOn(root.querySelectorAll('.series'), row);
            const n = row.getAttribute('data-note');
            if (n && hoops) hoops.textContent = n;
          });
        });
      }
    });
  }
  bindPlaygrounds();
  document.addEventListener('astro:after-swap', bindPlaygrounds);
</script>
