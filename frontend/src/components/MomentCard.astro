---
export interface Props { mo: any; }
const { mo } = Astro.props;
---
<div class="flex gap-4 rounded-card border border-border/80 bg-surface p-4 sm:p-5 shadow-card">
  <div class="shrink-0 grid place-items-center w-14 h-14 rounded-btn bg-pitch/10 text-pitch font-head font-bold text-lg">{mo.year}</div>
  <div class="min-w-0">
    <h3 class="font-head font-semibold leading-snug">{mo.title}</h3>
    <p class="mt-1 text-sm text-muted font-sans">{mo.text}</p>
  </div>
</div>
