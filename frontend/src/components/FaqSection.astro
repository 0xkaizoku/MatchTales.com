---
import type { FaqItem } from '../i18n/messages';
import { dict, localeFromPath } from '../i18n';

export interface Props {
  items?: FaqItem[];
  heading?: string;
}
const locale = Astro.locals?.locale || localeFromPath(Astro.url.pathname);
const d = dict(locale);
const { items = [], heading = d.common.faq } = Astro.props;
---
{items.length > 0 && (
  <section class="mt-12 mb-4" aria-labelledby="faq-h">
    <h2 id="faq-h" class="font-head text-xl font-semibold tracking-tight mb-4">{heading}</h2>
    <dl class="space-y-3">
      {items.map((item) => (
        <div class="rounded-card border border-border/80 bg-surface p-4">
          <dt class="font-head font-semibold text-[15px] leading-snug">{item.q}</dt>
          <dd class="mt-1.5 text-sm font-sans text-muted leading-6">{item.a}</dd>
        </div>
      ))}
    </dl>
  </section>
)}
