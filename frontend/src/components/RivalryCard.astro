---
export interface Props { r: any; }
const { r } = Astro.props;
---
<article data-testid="rivalry-card" class="group rounded-card overflow-hidden border border-border/80 bg-surface shadow-card hover:shadow-cardhover transition-shadow duration-200">
  <div class="relative aspect-[16/9] overflow-hidden">
    <img src={r.img} alt={r.title} loading="lazy" width="640" height="360" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
    <span class="absolute top-3 left-3 inline-flex items-center gap-1.5 rounded-full bg-coral/95 px-2.5 py-1 text-[11px] font-sans font-semibold text-white">⚡ Heat {r.heat}</span>
    <h3 class="absolute bottom-3 left-4 right-4 font-head text-lg font-semibold text-white leading-tight">{r.title}</h3>
  </div>
  <div class="p-4 sm:p-5">
    <p class="text-sm text-muted font-sans">{r.blurb}</p>
    <ul class="mt-3 space-y-1.5">
      {r.points.map((p: string) => (
        <li class="flex items-start gap-2 text-[13px] font-sans"><span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-pitch shrink-0"></span><span>{p}</span></li>
      ))}
    </ul>
  </div>
</article>
