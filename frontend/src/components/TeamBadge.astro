---
import { teamByName } from '../lib/site';
export interface Props { name: string; size?: 'sm' | 'md'; }
const { name, size = 'md' } = Astro.props;
const t = teamByName(name);
const slug = t ? t.slug : name.toLowerCase().replace(/\s+/g, '-');
---
<a href={`/team/${slug}`} class={`inline-flex items-center gap-1.5 hover:text-pitch transition-colors ${size === 'sm' ? 'text-sm' : ''}`}>
  <span>{t?.flag}</span><span class="font-medium">{name}</span>
</a>
