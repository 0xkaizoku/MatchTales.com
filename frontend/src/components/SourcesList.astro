---
import { dict, localeFromPath } from '../i18n';
import type { Locale } from '../i18n';
export interface Props {
  sources?: { name: string; url: string }[];
}
const locale = (Astro.locals?.locale || localeFromPath(Astro.url.pathname)) as Locale;
const d = dict(locale);
const { sources = [] } = Astro.props;
---
{sources.length > 0 && (
<section class="mt-10 rounded-card border border-border/80 bg-surface2/50 p-5" aria-labelledby="sources-h">
  <h2 id="sources-h" class="font-head text-sm font-semibold tracking-tight">{d.common.sources}</h2>
  <p class="mt-1 text-[12px] font-sans text-muted">{d.common.sourcesBlurb}</p>
  <ul class="mt-3 space-y-1.5 text-[13px] font-sans">
    {sources.map((s) => (
      <li>
        <a href={s.url} rel="noopener noreferrer" target="_blank" class="text-sky hover:underline underline-offset-2">{s.name}</a>
      </li>
    ))}
  </ul>
</section>
)}
