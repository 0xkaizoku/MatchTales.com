---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import MatchStoryCard from '../components/MatchStoryCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import HypeNotes from '../components/HypeNotes.astro';
import { getCollection } from 'astro:content';
import SportDirectory from '../components/SportDirectory.astro';
import { SITE, fmtDate, optimizeImage, contentImage, imgOnError, isWorldCup, SITE_TODAY } from '../lib/site';
import desk from '../data/desk.json';

const matchEntries = await getCollection('matches');
const matches = matchEntries.map((e) => e.data);
const todayStr = SITE_TODAY;

function addDays(dateStr: string, days: number) {
  const [y, m, d] = dateStr.split('-').map(Number);
  const dt = new Date(Date.UTC(y, m - 1, d + days));
  return dt.toISOString().slice(0, 10);
}
const tomorrowStr = addDays(todayStr, 1);

const featured =
  matches.find((m) => m.status === 'LIVE') ||
  matches.find((m) => m.slug === 'broncos-at-chiefs-mnf-2026') ||
  matches.find((m) => m.status === 'UPCOMING' && m.date >= todayStr) ||
  matches.find((m) => m.slug === 'zverev-vs-shelton-uso-final') ||
  matches.find((m) => m.slug === 'spain-vs-argentina-md9') ||
  matches[0];

const tonight = matches
  .filter((m) => m.date === todayStr && (m.status === 'UPCOMING' || m.status === 'LIVE'))
  .sort((a, b) => b.whyCareScore - a.whyCareScore);

const tomorrow = matches
  .filter((m) => m.date === tomorrowStr)
  .sort((a, b) => b.whyCareScore - a.whyCareScore);

const recent = matches
  .filter((m) => m.status === 'FINISHED' && !isWorldCup(m))
  .sort((a, b) => b.date.localeCompare(a.date) || b.whyCareScore - a.whyCareScore)
  .slice(0, 6);

const wcFinal = matches.find((m) => (m.group || '').toUpperCase() === 'FINAL');

const storyEntries = await getCollection('stories');
const stories = storyEntries
  .map((e) => ({ slug: e.id, ...e.data, image: contentImage(e.data.image, e.id, 480, 70) }))
  .sort((a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime())
  .slice(0, 6);

const preloadHero = featured?.image ? optimizeImage(featured.image, 1200, 78) : undefined;
const homeSchema = {
  '@type': 'WebPage',
  name: SITE.title,
  description: SITE.description,
  url: SITE.url,
  isPartOf: { '@id': `${SITE.url}/#website` },
};
---
<BaseLayout title={SITE.title} description={SITE.description} preloadImage={preloadHero} image={preloadHero || SITE.ogImage} schema={homeSchema} imageAlt="MatchTales: why this match matters">
  <main class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mt-6 flex flex-wrap items-center justify-between gap-3 rounded-card border border-border/70 bg-surface2 px-4 py-3">
      <div class="flex items-center gap-2 text-sm font-sans">
        <span class="font-head font-semibold text-pitch">The desk</span>
        <span class="text-muted">· {fmtDate(todayStr)}</span>
      </div>
      <div class="flex flex-wrap items-center gap-2 text-[12px] font-sans text-muted">
        <span class="inline-flex items-center gap-1.5 text-coral font-medium"><span class="w-2 h-2 rounded-full bg-coral pulse-glow"></span>Broncos at Chiefs, 8:15 p.m. ET</span>
        <span>· Leeds vs Newcastle, 8 p.m. UK</span>
        <span>· Zverev and Rybakina won the Open</span>
      </div>
    </div>

    {featured && (
      <section class="mt-6 fade-up"><Hero m={featured} /></section>
    )}

    <section class="mt-10">
      <SportDirectory />
    </section>

    <section class="mt-12" aria-labelledby="ny-h">
      <h2 id="ny-h" class="font-head text-2xl font-semibold tracking-tight">The US Open has names</h2>
      <p class="mt-2 text-muted font-sans max-w-2xl">Alexander Zverev beat Ben Shelton 6-3, 7-6 (2), 5-7, 6-2. Elena Rybakina beat Aryna Sabalenka 6-4, 5-7, 6-2. Shelton had already taken out Alcaraz at 3:33 a.m. Tiafoe had come from two sets down. Those are results. The tournament is finished.</p>
      <ul class="mt-4 grid sm:grid-cols-2 gap-3">
        {desk.usOpenQF.map((q) => (
          <li class="rounded-card border border-border/80 bg-surface p-4">
            <span class="text-[11px] font-sans text-muted uppercase tracking-wide">{q.draw}</span>
            <p class="mt-1 font-head font-semibold">{q.p1} <span class="text-muted font-sans font-normal">vs</span> {q.p2}</p>
            <p class="mt-1 text-[12px] font-sans text-muted">{q.status}</p>
          </li>
        ))}
      </ul>
      <p class="mt-3"><a href="/sport/tennis" class="text-sm font-sans font-medium text-sky hover:underline underline-offset-2">Tennis desk</a></p>
    </section>

    {tonight.length > 0 && (
      <section class="mt-12" aria-labelledby="ton-h">
        <div class="flex items-end justify-between gap-4 mb-4">
          <div>
            <h2 id="ton-h" class="font-head text-2xl font-semibold tracking-tight">Tonight · {fmtDate(todayStr)}</h2>
            <p class="text-sm text-muted font-sans mt-0.5">Broncos at Chiefs is the last snap of NFL Week 1. Leeds vs Newcastle is the last fixture of Premier League matchweek 4. Neither has a score.</p>
          </div>
          <a href="/sport/football" class="text-sm font-sans font-medium text-sky hover:underline underline-offset-4 whitespace-nowrap">Football desk</a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {tonight.map((m) => <MatchStoryCard m={m} />)}
        </div>
      </section>
    )}

    {tomorrow.length > 0 && (
      <section class="mt-12" aria-labelledby="tom-h">
        <div class="flex items-end justify-between gap-4 mb-4">
          <div>
            <h2 id="tom-h" class="font-head text-2xl font-semibold tracking-tight">Tomorrow · {fmtDate(tomorrowStr)}</h2>
            <p class="text-sm text-muted font-sans mt-0.5">What is dated tomorrow, if anything is.</p>
          </div>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {tomorrow.map((m) => <MatchStoryCard m={m} />)}
        </div>
      </section>
    )}

    {recent.length > 0 && (
      <section class="mt-12" aria-labelledby="rec-h">
        <h2 id="rec-h" class="font-head text-2xl font-semibold tracking-tight mb-4">Just happened</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {recent.map((m) => <MatchStoryCard m={m} />)}
        </div>
      </section>
    )}

    <section class="mt-12 grid lg:grid-cols-2 gap-8">
      <div>
        <h2 class="font-head text-xl font-semibold tracking-tight mb-3">Premier League after 4</h2>
        <ol class="space-y-2 font-sans text-sm">
          {desk.premierLeagueTable.slice(0, 4).map((r) => (
            <li class="flex items-center justify-between gap-3 border-b border-border/60 pb-2">
              <span><span class="text-muted tabular-nums mr-2">{r.pos}</span>{r.team}</span>
              <span class="font-head tabular-nums">{r.pts}</span>
            </li>
          ))}
        </ol>
        <p class="mt-3 text-[12px] text-muted">Arsenal and City are both 4-0-0. Hull are unbeaten on 8. Leeds vs Newcastle is still to play. <a href="/sport/soccer" class="text-sky hover:underline">Soccer desk</a></p>
      </div>
      <div>
        <h2 class="font-head text-xl font-semibold tracking-tight mb-3">F1 after Madrid</h2>
        <ol class="space-y-2 font-sans text-sm">
          {desk.f1Drivers.map((r) => (
            <li class="flex items-center justify-between gap-3 border-b border-border/60 pb-2">
              <span><span class="text-muted tabular-nums mr-2">{r.pos}</span>{r.name} <span class="text-muted">{r.team}</span></span>
              <span class="font-head tabular-nums">{r.pts}</span>
            </li>
          ))}
        </ol>
        <p class="mt-3 text-[12px] text-muted">Antonelli won the first Madring race. Baku is 24-26 September. <a href="/sport/f1" class="text-sky hover:underline">F1 desk</a></p>
      </div>
    </section>

    {wcFinal && (
      <section class="mt-12 rounded-card border border-pitch/25 bg-pitch/5 px-5 py-4">
        <p class="font-head font-semibold text-pitch">World Cup 2026 is a finished novel.</p>
        <p class="mt-1 text-sm font-sans text-muted">Spain 1-0 Argentina after extra time at MetLife, 19 July. Ferran Torres, 106th minute. England 6-4 France for bronze, Saka hat-trick. <a href="/world-cup" class="text-sky hover:underline underline-offset-2">Open the archive</a></p>
      </section>
    )}

    <section class="mt-12" aria-labelledby="st-h">
      <div class="flex items-end justify-between gap-4 mb-4">
        <h2 id="st-h" class="font-head text-2xl font-semibold tracking-tight">Latest stories</h2>
        <a href="/stories" class="text-sm font-sans font-medium text-sky hover:underline underline-offset-4">All stories</a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {stories.map((s) => (
          <a href={`/stories/${s.slug}`} class="group rounded-card overflow-hidden border border-border/80 bg-surface shadow-card hover:shadow-cardhover transition-shadow">
            <div class="aspect-[16/10] overflow-hidden bg-surface2"><img src={s.image} alt={s.title} loading="lazy" decoding="async" width="400" height="250" class="w-full h-full object-cover" onerror={imgOnError(s.slug)} /></div>
            <div class="p-4">
              <span class="text-[11px] font-sans font-medium text-pitch uppercase tracking-wide">{s.category}</span>
              <h3 class="mt-1 font-head font-semibold leading-snug group-hover:underline decoration-pitch decoration-2 underline-offset-4">{s.title}</h3>
              <p class="mt-1.5 text-sm text-muted font-sans line-clamp-2">{s.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-14" aria-labelledby="hype-h">
      <h2 id="hype-h" class="font-head text-2xl font-semibold tracking-tight">Fan hype wall</h2>
      <p class="text-sm text-muted font-sans mt-0.5 mb-5">Why do <em>you</em> care? Add your voice to the wall.</p>
      <HypeNotes />
    </section>

    <section id="newsletter" class="mt-14 mb-8 scroll-mt-20">
      <div class="relative overflow-hidden rounded-card border border-border/70 bg-surface shadow-card grain">
        <div class="absolute inset-0 pointer-events-none" style="background: var(--hero-bg)"></div>
        <div class="relative p-6 sm:p-10">
          <h2 class="font-head text-2xl sm:text-3xl font-semibold tracking-tight">Never miss a story that matters</h2>
          <p class="mt-2 text-muted font-sans max-w-lg">One email when the stake is real: the rematch, the round, the race. Straight to your inbox.</p>
          <div class="mt-5"><NewsletterForm /></div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
