---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
const schema = {
  '@type': 'WebPage',
  name: 'Privacy Policy',
  description: 'How MatchTales handles your data. We collect almost nothing and never sell it.',
  url: `${SITE.url}/privacy`,
  isPartOf: { '@id': `${SITE.url}/#website` },
};
---
<BaseLayout title="Privacy Policy" description="How MatchTales handles your data. Short version: we collect almost nothing, and we never sell it." schema={schema} imageAlt="MatchTales privacy policy">
  <main class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto py-10">
      <h1 class="font-head text-3xl sm:text-4xl font-semibold tracking-tight">Privacy Policy</h1>
      <p class="mt-2 text-muted font-sans">Last updated: June 2026</p>
      <div class="mt-8 space-y-6 font-sans text-[15px] leading-7 text-fg">
        <section><h2 class="font-head text-lg font-semibold mb-1">The short version</h2><p class="text-muted">We collect as little as possible. We never sell your data. We use it only to send you what you asked for.</p></section>
        <section><h2 class="font-head text-lg font-semibold mb-1">What we collect</h2><p class="text-muted">If you subscribe to our newsletter, we store your email address. If you post a hype note, we store the note text and any name you choose to add. That's it. We do not require accounts and we do not track you across the web.</p></section>
        <section><h2 class="font-head text-lg font-semibold mb-1">How we use it</h2><p class="text-muted">Email addresses are used solely to send match-day stories and updates you opted into. Hype notes are displayed publicly on the site (moderated for spam and abuse). We may show aggregate, anonymous poll results.</p></section>
        <section><h2 class="font-head text-lg font-semibold mb-1">Third parties</h2><p class="text-muted">We display live football data from public sports data providers and embed media from third-party platforms. Those services have their own privacy policies. We do not share your personal information with them.</p></section>
        <section><h2 class="font-head text-lg font-semibold mb-1">Your choices</h2><p class="text-muted">You can unsubscribe from emails at any time. To request deletion of your email or a hype note, get in touch and we'll remove it promptly.</p></section>
        <section><h2 class="font-head text-lg font-semibold mb-1">Contact</h2><p class="text-muted">Questions about privacy? Reach out via our social channels in the footer. MatchTales is an independent fan project and not affiliated with FIFA.</p></section>
      </div>
    </div>
  </main>
</BaseLayout>
