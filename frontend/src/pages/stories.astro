---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const entries = await getCollection('stories');
const stories = entries.map((e) => ({ slug: e.id, ...e.data })).sort((a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime());
const featured = stories[0];
const rest = stories.slice(1);
---
<BaseLayout title="Stories — World Cup 2026 Long Reads | MatchTales" description="Long-form football storytelling: the greatest upsets, the legends saying goodbye, the rivalries and the hosts' tale.">
  <main class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <header class="mt-8">
      <h1 class="font-head text-3xl sm:text-4xl font-semibold tracking-tight">Stories</h1>
      <p class="mt-2 text-muted font-sans max-w-2xl">The deep cuts — long reads on the upsets, the legacies and the moments that make this tournament unforgettable.</p>
    </header>
    {featured && (
      <a href={`/stories/${featured.slug}`} class="group mt-6 grid md:grid-cols-2 gap-0 rounded-card overflow-hidden border border-border/80 bg-surface shadow-card hover:shadow-cardhover transition-shadow">
        <div class="aspect-[16/10] md:aspect-auto overflow-hidden"><img src={featured.image} alt={featured.title} width="640" height="400" class="w-full h-full object-cover" /></div>
        <div class="p-6 sm:p-8 flex flex-col justify-center">
          <span class="text-[11px] font-sans font-medium text-pitch uppercase tracking-wide">{featured.category} · {featured.readingTime} min read</span>
          <h2 class="mt-2 font-head text-2xl sm:text-3xl font-semibold tracking-tight leading-tight group-hover:underline decoration-pitch decoration-2 underline-offset-4">{featured.title}</h2>
          <p class="mt-3 text-muted font-sans">{featured.excerpt}</p>
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-sans font-medium text-sky">Read the story <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </div>
      </a>
    )}
    <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-5 pb-10">
      {rest.map((s) => (
        <a href={`/stories/${s.slug}`} class="group rounded-card overflow-hidden border border-border/80 bg-surface shadow-card hover:shadow-cardhover transition-shadow">
          <div class="aspect-[16/10] overflow-hidden"><img src={s.image} alt={s.title} loading="lazy" width="420" height="262" class="w-full h-full object-cover" /></div>
          <div class="p-5"><span class="text-[11px] font-sans font-medium text-pitch uppercase tracking-wide">{s.category} · {s.readingTime} min</span><h3 class="mt-1 font-head text-lg font-semibold leading-snug group-hover:underline decoration-pitch decoration-2 underline-offset-4">{s.title}</h3><p class="mt-1.5 text-sm text-muted font-sans line-clamp-2">{s.excerpt}</p></div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
