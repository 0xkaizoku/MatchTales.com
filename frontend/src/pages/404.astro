---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Match not found — MatchTales" description="This page slipped past the keeper.">
  <main class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="min-h-[60vh] grid place-items-center text-center py-16">
      <div>
        <div class="relative mx-auto w-28 h-28">
          <svg viewBox="0 0 100 100" class="w-full h-full text-pitch"><circle cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="2" opacity="0.3"/><path d="M50 14 L62 24 L57 40 L43 40 L38 24 Z M50 50 m-9 0 a9 9 0 1 0 18 0 a9 9 0 1 0 -18 0" fill="currentColor"/><path d="M20 40 L30 30 M80 40 L70 30 M28 72 L38 64 M72 72 L62 64" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
        </div>
        <p class="mt-6 font-head text-6xl font-bold text-pitch">404</p>
        <h1 class="mt-2 font-head text-2xl font-semibold tracking-tight">Match not found</h1>
        <p class="mt-2 text-muted font-sans max-w-sm mx-auto">This one slipped past the keeper. The page you're after doesn't exist — but there's a whole tournament waiting.</p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a href="/" class="inline-flex items-center h-11 rounded-btn bg-pitch px-5 font-sans font-medium text-white hover:bg-pitch2 transition-colors">Back to home</a>
          <a href="/fixtures" class="inline-flex items-center h-11 rounded-btn border border-border px-5 font-sans font-medium hover:bg-surface2 transition-colors">Browse fixtures</a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
