---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MatchStoryCard from '../../components/MatchStoryCard.astro';
import { getCollection } from 'astro:content';
import { data, teamBySlug } from '../../lib/site';

export async function getStaticPaths() {
  return data.teams.map((t: any) => ({ params: { slug: t.slug }, props: { team: t } }));
}
const { team } = Astro.props;
const dossiers = await getCollection('teams');
const dossier = dossiers.find((d) => d.data.slug === team.slug)?.data;
const matchEntries = await getCollection('matches');
const teamMatches = matchEntries.map((e) => e.data).filter((m) => m.home === team.name || m.away === team.name).sort((a, b) => a.date.localeCompare(b.date));
const standing = data.groups[team.group];
const pos = standing.findIndex((r: any) => r.name === team.name) + 1;
const paras = dossier ? dossier.dossier.split(/\n\n+/).filter(Boolean) : [team.story];

const schema = {
  '@context': 'https://schema.org', '@type': 'SportsTeam', name: team.name, sport: 'Soccer',
  description: team.story,
};
---
<BaseLayout title={`${team.name} — World Cup 2026 Guide | MatchTales`} description={team.story} schema={schema}>
  <main class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <!-- header band -->
    <div class="mt-6 relative overflow-hidden rounded-card border border-border/70 shadow-card" style={`background: linear-gradient(135deg, ${team.color}22, transparent)`}>
      <div class="p-6 sm:p-8">
        <nav class="text-[13px] font-sans text-muted flex items-center gap-1.5 mb-4"><a href="/teams" class="hover:text-fg">Teams</a><span>/</span><a href={`/group/${team.group.toLowerCase()}`} class="hover:text-fg">Group {team.group}</a><span>/</span><span class="text-fg">{team.name}</span></nav>
        <div class="flex items-center gap-4">
          <span class="text-6xl">{team.flag}</span>
          <div>
            <h1 class="font-head text-3xl sm:text-4xl font-semibold tracking-tight">{team.name}</h1>
            <p class="text-muted font-sans">{team.nick} · World ranking #{team.rank}</p>
          </div>
        </div>
        <div class="mt-5 flex flex-wrap gap-2 text-[12px] font-sans">
          <span class="rounded-full bg-surface px-3 py-1 border border-border">Group {team.group} · {pos}{pos===1?'st':pos===2?'nd':pos===3?'rd':'th'}</span>
          <span class="rounded-full bg-surface px-3 py-1 border border-border">{team.conf}</span>
          <span class="rounded-full bg-surface px-3 py-1 border border-border">{team.titles > 0 ? `★ ${team.titles} World Cup${team.titles>1?'s':''}` : 'Chasing a first title'}</span>
          <span class="rounded-full bg-surface px-3 py-1 border border-border">Best: {team.best}</span>
        </div>
      </div>
    </div>

    <div class="mt-8 grid lg:grid-cols-3 gap-8">
      <article class="lg:col-span-2 min-w-0">
        <h2 class="font-head text-2xl font-semibold tracking-tight">The story</h2>
        <div class="mt-3 space-y-4 text-[17px] leading-8">{paras.map((p: string) => <p>{p}</p>)}</div>

        {dossier && (
          <div class="mt-6 grid sm:grid-cols-2 gap-4">
            <div class="rounded-card border border-border/80 bg-surface p-5"><h3 class="font-head text-sm font-semibold uppercase tracking-wide text-pitch">What to watch</h3><p class="mt-2 text-[15px] font-sans leading-7">{dossier.whatToWatch}</p></div>
            <div class="rounded-card border border-border/80 bg-surface p-5"><h3 class="font-head text-sm font-semibold uppercase tracking-wide text-coral">X-factor</h3><p class="mt-2 text-[15px] font-sans leading-7">{dossier.xFactor}</p></div>
          </div>
        )}
        {dossier && <p class="mt-4 text-lg font-head italic text-pitch border-l-2 border-pitch pl-4">{dossier.verdict}</p>}

        <section class="mt-8">
          <h2 class="font-head text-xl font-semibold tracking-tight mb-3">Their fixtures</h2>
          <div class="grid sm:grid-cols-2 gap-4">{teamMatches.map((m) => <MatchStoryCard m={m} />)}</div>
        </section>
      </article>

      <aside class="space-y-5">
        <div class="rounded-card border border-border/80 bg-surface p-5 shadow-card">
          <h3 class="font-head font-semibold mb-3">Key players</h3>
          <ul class="space-y-2.5">{team.keyPlayers.map((p: any) => (<li class="flex items-center justify-between"><span class="font-sans text-sm font-medium">{p[0]}</span><span class="text-[11px] text-muted font-sans rounded-full bg-surface2 px-2 py-0.5">{p[1]}</span></li>))}</ul>
        </div>
        <div class="rounded-card border border-border/80 bg-surface p-5 shadow-card">
          <h3 class="font-head font-semibold mb-2">Fun facts</h3>
          <ul class="space-y-2 text-sm font-sans text-muted"><li class="flex gap-2"><span class="text-pitch">•</span>{team.funFact}</li>{(dossier?.funFacts || []).map((f: string) => <li class="flex gap-2"><span class="text-pitch">•</span>{f}</li>)}</ul>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>
